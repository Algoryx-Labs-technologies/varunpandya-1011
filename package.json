{
  "name": "trading-monorepo",
  "version": "1.0.0",
  "description": "Trading bot monorepo with custom backend and frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:backend": "npm run dev --workspace=@trading/backend",
    "dev:frontend": "npm run dev --workspace=@trading/frontend",
    "build": "npm run build --workspaces",
    "start:backend": "npm start --workspace=@trading/backend",
    "start:frontend": "npm run preview --workspace=@trading/frontend",
    "run:system": "node run-system.js",
    "run:bot": "node run-bot.js"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

