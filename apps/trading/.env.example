# =============================================================================
# Vertex Options Trading – Environment Template
# Copy to .env and fill values. Handles edge cases per module (data, levels, risk, journal, etc.)
# =============================================================================

# -----------------------------------------------------------------------------
# Broker: Angel One (required for connection; TOTP for 2FA)
# Edge cases: empty/missing = bot won’t connect; use key.txt for secrets
# -----------------------------------------------------------------------------
ANGEL_ONE_API_KEY=your_api_key_here
ANGEL_ONE_CLIENT_SECRET=your_client_secret
ANGEL_ONE_CLIENT_ID=your_client_id
ANGEL_ONE_PASSWORD=your_password
ANGEL_ONE_TOTP_SECRET=your_totp_secret
# Optional: 4-digit mPIN if Angel One requires mPIN login (instead of password)
# ANGEL_ONE_MPIN=1234

# -----------------------------------------------------------------------------
# Trading / Capital
# Edge cases: TRADING_CAPITAL=0 disables allocation; allocations should sum to 1.0 for NIFTY+BANKNIFTY+FINNIFTY
# -----------------------------------------------------------------------------
TRADING_CAPITAL=20000
NIFTY_ALLOCATION=0.5
BANKNIFTY_ALLOCATION=0.5
FINNIFTY_ALLOCATION=0.0

# -----------------------------------------------------------------------------
# Risk (risk_manager, auto-lock, kill switch)
# Edge cases: MAX_TRADES_PER_DAY=0 = no trading; KILL_SWITCH_TIME in HH:MM (24h)
# -----------------------------------------------------------------------------
MAX_TRADES_PER_DAY=4
TRADE_CYCLES=2
TRADES_PER_CYCLE=2
KILL_SWITCH_TIME=15:15
STOP_LOSS_PERCENTAGE=2.0
TARGET_PERCENTAGE=1.5

# Trade cycle: stop new trades when net PnL reaches target % of TRADING_CAPITAL (opt-in)
# ENABLE_NET_PNL_TARGET=true to enable; NET_PNL_TARGET_PERCENT=e.g. 20 for 20%
ENABLE_NET_PNL_TARGET=false
NET_PNL_TARGET_PERCENT=20

# -----------------------------------------------------------------------------
# Strategy (levels + patterns + candle wait)
# Edge cases: CANDLES_TO_WAIT 7–10; invalid floats fall back to config defaults
# -----------------------------------------------------------------------------
CANDLES_TO_WAIT=7
# Min candles to hold before allowing take-profit or time-based square off (stop loss still immediate)
MIN_CANDLES_BEFORE_EXIT=7
# Number of candles after which to square off (time-based exit); use 7–10
CANDLES_BEFORE_SQUARE_OFF=10
MIN_CANDLE_BODY_SIZE=0.3
MIN_WICK_RATIO=0.5
# Optional: exclude very large bodies from pattern match (0 = no max)
PATTERN_MAX_BODY_SIZE=0
# best_return = optimal allocation by highest historical return (utilization × ATM weight); or atm, itm, otm
STRIKE_PREFERENCE=best_return
# Optional: comma-separated daily strikes per index (e.g. 29050,29100,29150,29200)
# DAILY_STRIKES_NIFTY=
# DAILY_STRIKES_BANKNIFTY=
# DAILY_STRIKES_FINNIFTY=

# -----------------------------------------------------------------------------
# Data (data_fetcher): real-time / NSE only (no yfinance)
# Edge cases: timeouts/retries for NSE; broker token failure = no OHLC
# -----------------------------------------------------------------------------
# Optional: request timeout for NSE/broker (seconds)
DATA_FETCH_TIMEOUT=15
# Optional: NSE option-chain retries on 403/5xx
NSE_OPTION_CHAIN_RETRIES=2

# -----------------------------------------------------------------------------
# Levels (levels/): manual levels file path
# Edge cases: missing file = no manual levels; use CSV or Excel (see levels/README_LEVELS.md)
# -----------------------------------------------------------------------------
LEVELS_FILE=levels/levels.csv

# -----------------------------------------------------------------------------
# Journal (journal/): trade log path and retention
# Edge cases: path must be writable; invalid path = log only to console/memory
# -----------------------------------------------------------------------------
# JOURNAL_DIR defaults to DATA_DIR; set if you want logs outside app
# JOURNAL_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Backend API (api/integration.py)
# Edge cases: unreachable URL = bot continues without pushing signals/trades
# -----------------------------------------------------------------------------
BACKEND_API_URL=http://localhost:3000
BACKEND_API_KEY=

# -----------------------------------------------------------------------------
# Paper vs Live trading (default = paper = no real orders)
# PAPER_TRADING=true  = paper mode (current default): data, signals, logs only; no orders.
# PAPER_TRADING=false = live mode: real orders sent to broker.
# Or use TRADING_MODE=paper | TRADING_MODE=live
# -----------------------------------------------------------------------------
PAPER_TRADING=true
# TZ=Asia/Kolkata

# -----------------------------------------------------------------------------
# Logging
# Edge cases: LOG_LEVEL=DEBUG for troubleshooting; LOG_FILE path relative to app or absolute
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=trading.log
