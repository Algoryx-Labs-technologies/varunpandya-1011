PORT=3000
BACKEND_URL=http://localhost:3000
WEBSOCKET_URL=ws://localhost:3000

# Angel One Smart Stream (real-time LTP). Optional – if set, stream starts with server.
# Get JWT + feedToken from login API; clientCode = your Angel One client code.
# ANGELONE_WS_JWT=
# ANGELONE_WS_FEED_TOKEN=
# ANGELONE_CLIENT_CODE=
# Comma-separated token list (default: 26000,26009,26037,25974 for NIFTY/BANKNIFTY/FINNIFTY/MIDCPNIFTY)
# SMART_STREAM_TOKENS=26000,26009
